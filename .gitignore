# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OCR benchmark run artifacts (dated outputs, not source)
ocr-benchmarks/benchmarks/runs/
ocr-benchmarks/probes/runs/

# .NET build output for the bridges (IronOCR, ABBYY). Keep source only.
ocr-benchmarks/bridges/**/bin/
ocr-benchmarks/bridges/**/obj/

# Third-party source trees cloned into the repo (nested .git). Install
# instructions live in third_party/README.md; the clones themselves stay
# out of git — their upstream URL + pinned commit are enough.
ocr-benchmarks/third_party/*
!ocr-benchmarks/third_party/README.md

# Early ocr-tests / pdf-tests outputs (large, regeneratable)
ocr-tests/results/
pdf-tests/results/
pdf-tests/results-carmel/

# Local invoice test corpora (large; kept out of git)
pdf-tests/invoices-pdf-testing/
pdf-tests/new-pdf-250-invoices-carmel-tests/
pdf-tests/hebrew-ocr-forms/

# Secrets — license keys, API tokens, service-account JSONs. NEVER commit.
.env
.env.*
!.env.example
*.license
*LicenseKey*
# GCP service-account JSONs are placed at the ocr-benchmarks root by
# convention — block any JSON directly at that level. Config/data JSONs
# live under benchmarks/ subdirs, which stay allowed.
ocr-benchmarks/*.json
*-service-account*.json
*gcp-key*.json
*google-credentials*.json

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
