# Example .env for the OCR benchmark harness.
# Copy to `.env` (same directory) and fill in your actual values.
# `.env` is gitignored; this `.env.example` is safe to commit.
#
# Loaded automatically by the IronOCR and ABBYY adapters at run time.
# os.environ wins over values here — exporting the variable in your
# shell will override whatever's in this file.

# Candidate #5 — IronOCR commercial license key.
# Trial keys come from https://ironsoftware.com/csharp/ocr/licensing/
IRONOCR_LICENSE_KEY=IRONSUITE.YOUR.KEY.HERE

# Candidate #6 — ABBYY FineReader Engine 12 licensing.
# Provide either a developer serial OR a path to a .ABBYY.LicenseKey file.
# ABBYY_FRE_DEVELOPER_SERIAL=XXXXX-XXXXX-XXXXX-XXXXX
# ABBYY_FRE_LICENSE_PATH=C:/path/to/license.ABBYY.LicenseKey

# Google Cloud Vision — cloud OCR PROBE only, NOT one of the six candidates
# (roadmap §1 bans hosted OCR services). Used by
# `probes/google_vision_probe.py` to see how cloud OCR compares. Delete this
# section if you decide to drop the probe. Get an API key at:
# https://console.cloud.google.com/apis/credentials
# GOOGLE_VISION_API_KEY=AIza...
